#include <winver.h>

/* --- icone de l'application (1 = utilisee aussi par la zone de notification) --- */
1 ICON "app.ico"

/* --- manifeste : application normale, sans droits admin, Windows 10/11 --- */
1 24 "app.manifest"

/* --- informations de version (un exe sans version est plus suspecte) --- */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName", "Groupe Scolaire Les Theoremes"
            VALUE "FileDescription", "Les Theoremes - Espace scolaire"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "les-theoremes"
            VALUE "LegalCopyright", "(c) 2026 Groupe Scolaire Les Theoremes"
            VALUE "OriginalFilename", "Les-Theoremes.exe"
            VALUE "ProductName", "Les Theoremes"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Comments", "Application scolaire - serveur local et interface"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40c, 1200
    END
END
